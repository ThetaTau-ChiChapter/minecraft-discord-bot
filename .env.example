DISCORD_TOKEN=your-discord-bot-token
RCON_ADDRESS=minecraft-server:25575
RCON_PASSWORD=your-rcon-password

# Name of the Docker network that the minecraft-server container is on.
# Find it by running on the machine that hosts minecraft-server:
#   docker inspect minecraft-server --format '{{json .NetworkSettings.Networks}}'
MINECRAFT_NETWORK=minecraft-server_default
